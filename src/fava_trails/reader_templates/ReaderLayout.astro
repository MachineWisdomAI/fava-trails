---
const { title, scope, generatedAt } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" href="data:," />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · FAVA Reader</title>
  <style is:global>
    :root { font-family: ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:#202b2a; background:#f4f5f1; font-size:15px; }
    * { box-sizing:border-box; }
    body { margin:0; }
    a { color:#175e51; text-underline-offset:3px; overflow-wrap:anywhere; }
    a:hover { color:#083d32; }
    :focus-visible { outline:3px solid #b16a15; outline-offset:3px; }
    main { max-width:1240px; margin:auto; padding:22px 24px 50px; }
    .masthead { display:flex; justify-content:space-between; align-items:center; gap:12px; border-bottom:1px solid #ccd7d0; padding:13px max(24px,calc((100vw - 1192px)/2)); background:#e9eee7; }
    .brand { font-weight:750; text-decoration:none; letter-spacing:-.02em; }
    .snapshot { font-size:.8rem; color:#526059; }
    .eyebrow { color:#596a60; font-size:.76rem; text-transform:uppercase; letter-spacing:.08em; margin:0 0 7px; }
    h1 { font-size:1.65rem; line-height:1.25; letter-spacing:-.03em; margin:0 0 10px; overflow-wrap:anywhere; }
    h2 { font-size:1.12rem; margin:0 0 12px; }
    h3 { font-size:.92rem; margin:0 0 8px; }
    p { line-height:1.5; }
    .muted { color:#59675f; }
    .freshness { font-size:.8rem; color:#5e6c63; margin:7px 0 18px; overflow-wrap:anywhere; }
    .panel { background:#fff; border:1px solid #d6ded7; border-radius:7px; padding:16px; min-width:0; }
    .badge { display:inline-block; padding:2px 7px; border:1px solid #d6ded7; border-radius:4px; font-size:.74rem; background:#f1f4ee; overflow-wrap:anywhere; }
    .badge[data-status="approved"] { color:#205343; background:#e5f0e5; border-color:#aec9b8; }
    .badge[data-status="draft"], .badge[data-status="proposed"] { color:#734c10; background:#fff2d5; border-color:#dbc17a; }
    .badge[data-status="rejected"], .badge[data-status="tombstoned"], .warning { color:#823a31; background:#fff1ee; border-color:#d9b1aa; }
    .badge[data-status="superseded"] { color:#665c82; background:#eeebf4; border-color:#c4bdd8; }
    .warning { border:1px solid #d9b1aa; border-radius:6px; padding:12px; overflow-wrap:anywhere; }
    .tag { color:#536555; font-size:.76rem; }
    code { font-size:.8rem; overflow-wrap:anywhere; }
    .meta { display:flex; flex-wrap:wrap; align-items:center; gap:6px 13px; font-size:.8rem; color:#59675f; }
    ul.clean { list-style:none; padding:0; margin:0; }
    .stack > * + * { margin-top:12px; }
    .two-column { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16px; margin:18px 0; }
    .links li { padding:8px 0; border-bottom:1px solid #edf0eb; overflow-wrap:anywhere; }
    .links li:last-child { border:0; }
    .empty { color:#667269; font-size:.85rem; }
    .source-body { line-height:1.7; padding:24px; margin-top:18px; overflow-wrap:anywhere; }
    .source-body img { max-width:100%; height:auto; }
    .source-body pre { overflow:auto; padding:14px; background:#f2f4ef; max-width:100%; }
    .source-body table { display:block; overflow:auto; border-collapse:collapse; }
    .source-body td,.source-body th { padding:7px; border:1px solid #d6ded7; }
    .source-body h1 { font-size:1.45rem; } .source-body h2 { margin-top:24px; }
    [hidden] { display:none !important; }
    @media(max-width:640px) {
      main { padding:17px 14px 35px; }
      .masthead { padding:12px 14px; }
      .two-column { grid-template-columns:1fr; }
      h1 { font-size:1.35rem; }
      .source-body { padding:16px; }
      .snapshot { max-width:140px; text-align:right; }
    }
  </style>
</head>
<body>
  <a href="#main" class="skip">Skip to content</a>
  <div class="masthead"><a class="brand" href="/">FAVA / Reader</a><span class="snapshot">Local · Read only · Static snapshot</span></div>
  <main id="main"><slot /><footer class="freshness">Input scope: {scope} · Generated at: <time datetime={generatedAt}>{generatedAt}</time>. Static snapshot; not a live view.</footer></main>
  <style>.skip { position:absolute; top:-100px; background:white; padding:10px; z-index:2; } .skip:focus { top:0; }</style>
</body>
</html>
